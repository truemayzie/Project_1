---
import "../styles/global.css";

const navItems = [
  { href: "#work", label: "Работы" },
  { href: "#sections", label: "Секции" },
  { href: "#method", label: "Метод" },
  { href: "#contact", label: "Связь" },
];

const projects = [
  {
    number: "01",
    title: "Лендинг для частного архитектора",
    type: "личный бренд",
    year: "2026",
    description:
      "Главная страница без стоковых карточек: крупные планы, строгая сетка, короткие подписи и форма заявки в один экран.",
  },
  {
    number: "02",
    title: "Витрина секций для небольшой студии",
    type: "section kit",
    year: "2026",
    description:
      "Набор блоков, который можно переставлять: intro, услуги, кейс, прайс, FAQ. Каждый блок держит общий ритм.",
  },
  {
    number: "03",
    title: "Промо-страница цифрового продукта",
    type: "product page",
    year: "2025",
    description:
      "Неоновый SaaS-лендинг заменен на спокойную продуктовую подачу: один тезис, доказательства, демо и понятный CTA.",
  },
];

const sections = [
  ["00", "Обложка", "крупный заголовок, один тезис, навигация без шума"],
  ["01", "Услуги", "две-три сильные карточки вместо сетки из двенадцати иконок"],
  ["02", "Кейс", "контекст, задача, решение, результат; без фальшивых метрик"],
  ["03", "Прайс", "честное сравнение пакетов и спокойный CTA"],
  ["04", "FAQ", "короткие ответы, чтобы убрать тревогу перед заявкой"],
  ["05", "Контакт", "почта, Telegram, availability и следующий шаг"],
];

const principles = [
  "Сначала текст и ритм страницы, потом декоративные детали.",
  "Один визуальный прием на секцию. Если приемов больше — убираем.",
  "Адаптивность проектируется как отдельный макет, а не как сжатая desktop-версия.",
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Портфолио Ивана Ротова: верстка, лендинги, портфолио и библиотека секций на Astro + Tailwind."
    />
    <meta name="theme-color" content="#f3eee3" />
    <title>Иван Ротов — верстка и секции для сайтов</title>
  </head>
  <body>
    <div class="paper-grain" aria-hidden="true"></div>

    <header class="mx-auto grid w-full max-w-[1380px] grid-cols-[1fr_auto] items-start gap-6 px-4 py-4 sm:px-6 lg:grid-cols-[260px_1fr_260px] lg:px-8">
      <a class="brand-mark" href="#top" aria-label="Иван Ротов, наверх">
        <span>ИР</span>
        <small>верстка / секции / сайты</small>
      </a>

      <nav class="hidden justify-self-center border-x border-black/20 px-4 text-[12px] font-bold uppercase tracking-[0.18em] text-black/70 md:flex">
        {
          navItems.map((item) => (
            <a class="border-r border-black/20 px-4 py-3 last:border-r-0 hover:bg-black hover:text-[#f3eee3]" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="header-contact" href="mailto:ivan.rotov@example.com">ivan.rotov@example.com</a>
    </header>

    <main id="top">
      <section class="mx-auto grid min-h-[calc(100vh-72px)] w-full max-w-[1380px] border-y border-black/20 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_420px] lg:px-8">
        <div class="border-black/20 py-10 lg:border-r lg:py-16 lg:pr-10">
          <p class="eyebrow">Portfolio no. 01 / Ivan Rotov</p>
          <h1 class="mt-8 max-w-5xl font-serif text-[clamp(4.6rem,14vw,13rem)] font-black leading-[0.76] tracking-[-0.09em] text-black">
            Сайты без сладкой ваты.
          </h1>
          <div class="mt-9 grid gap-6 border-t border-black/20 pt-6 md:grid-cols-[1fr_0.8fr]">
            <p class="max-w-2xl text-xl leading-8 text-black/76">
              Иван Ротов собирает лендинги, портфолио и библиотеки секций: с нормальной типографикой,
              ясной структурой и без пластикового блеска “как у всех”.
            </p>
            <div class="fact-card">
              <span>Сейчас</span>
              <strong>Доступен для 1-2 проектов</strong>
              <p>Лучше всего подойдут сайты для специалистов, студий и небольших продуктов.</p>
            </div>
          </div>
        </div>

        <aside class="relative py-6 lg:pl-8">
          <div class="specimen-card">
            <div class="specimen-top">
              <span>layout specimen</span>
              <span>astro + tailwind</span>
            </div>
            <div class="specimen-title">
              <span>Не</span>
              <span>генерик</span>
            </div>
            <svg class="hero-sketch" viewBox="0 0 360 240" role="img" aria-labelledby="hero-sketch-title">
              <title id="hero-sketch-title">Отрисованная схема страницы с карандашом и секциями</title>
              <path class="ink" d="M44 33c60-15 151-10 252 4 11 1 19 10 18 22l-10 121c-1 12-11 21-23 20-68-5-137-8-207 4-13 2-25-8-25-21L34 58c-1-12 2-22 10-25Z" />
              <path class="orange-fill" d="M58 52c52-10 141-5 235 8l-3 37c-78-6-151-9-224 3L58 52Z" />
              <path class="ink" d="M66 116c35-7 74-9 116-5M67 143c54-9 111-10 172-3M68 171c31-6 63-8 97-5" />
              <path class="ink" d="M222 111c22-1 43 1 62 5l-6 48c-21-3-41-5-61-3l5-50Z" />
              <path class="ink" d="M105 77c18-4 38-4 61-1M185 76c21 0 44 2 68 5" />
              <path class="orange-stroke" d="M285 25c10 19 19 43 25 71M311 37c-12 5-22 14-30 27" />
              <path class="ink" d="M283 169l29 41 15-9-28-41-16 9ZM310 211l13 19" />
              <path class="ink thin" d="M78 213c32-11 71-16 118-15M17 111c7-6 16-9 27-10M330 121c12 3 20 8 25 16" />
            </svg>
            <div class="mt-8 grid grid-cols-2 border border-black/25">
              <div class="min-h-32 border-r border-black/25 p-4">
                <span class="label">grid</span>
                <p class="mt-8 text-3xl font-black leading-none tracking-[-0.05em]">12 columns</p>
              </div>
              <div class="min-h-32 p-4">
                <span class="label">tone</span>
                <p class="mt-8 text-3xl font-black leading-none tracking-[-0.05em]">dry / sharp</p>
              </div>
            </div>
            <div class="mt-4 border border-black/25 p-4">
              <span class="label">rule</span>
              <p class="mt-12 max-w-xs text-2xl font-black leading-none tracking-[-0.05em]">
                Если блок можно узнать по шаблону — блок переделывается.
              </p>
            </div>
          </div>
        </aside>
      </section>

      <section id="work" class="mx-auto w-full max-w-[1380px] px-4 py-16 sm:px-6 lg:px-8">
        <div class="section-heading">
          <p class="eyebrow">Selected work</p>
          <h2>Три направления, в которых сайт должен держать лицо.</h2>
        </div>

        <div class="mt-10 border-t border-black/25">
          {
            projects.map((project) => (
              <article class="project-row">
                <div class="project-number">{project.number}</div>
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>
                <div class={`project-sketch sketch-${project.number}`} aria-hidden="true">
                  {project.number === "01" && (
                    <svg viewBox="0 0 180 126">
                      <path class="orange-fill" d="M20 86 86 22l68 64H20Z" />
                      <path class="ink" d="M18 88 87 20l72 69M43 88V57l43-37 45 38v30M69 88V61h34v27" />
                      <path class="ink thin" d="M25 100c35-6 77-7 128 0M52 51c12 5 23 5 34-1M113 51c9 5 20 6 32 1" />
                    </svg>
                  )}
                  {project.number === "02" && (
                    <svg viewBox="0 0 180 126">
                      <path class="ink" d="M24 22h132v82H24z" />
                      <path class="orange-fill" d="M37 34h45v24H37zM96 34h47v24H96z" />
                      <path class="ink" d="M37 34h45v24H37zM96 34h47v24H96zM37 72h106M37 86h66" />
                      <path class="orange-stroke" d="M20 111c36-10 82-10 139 0" />
                    </svg>
                  )}
                  {project.number === "03" && (
                    <svg viewBox="0 0 180 126">
                      <path class="ink" d="M54 13h72c8 0 14 6 14 14v72c0 8-6 14-14 14H54c-8 0-14-6-14-14V27c0-8 6-14 14-14Z" />
                      <path class="orange-fill" d="M55 31h70v27H55z" />
                      <path class="ink" d="M55 31h70v27H55zM55 73h42M55 86h65M79 101h22" />
                      <path class="ink thin" d="M31 42c-9 11-10 24-2 38M149 42c9 11 10 24 2 38" />
                    </svg>
                  )}
                </div>
                <dl>
                  <div>
                    <dt>тип</dt>
                    <dd>{project.type}</dd>
                  </div>
                  <div>
                    <dt>год</dt>
                    <dd>{project.year}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </section>

      <section id="sections" class="mx-auto grid w-full max-w-[1380px] gap-8 border-y border-black/20 px-4 py-16 sm:px-6 lg:grid-cols-[360px_1fr] lg:px-8">
        <div>
          <p class="eyebrow">Section library</p>
          <h2 class="mt-5 font-serif text-6xl font-black leading-[0.86] tracking-[-0.07em] text-black md:text-8xl">
            Набор блоков, а не набор клише.
          </h2>
          <svg class="library-sketch" viewBox="0 0 340 230" role="img" aria-labelledby="library-sketch-title">
            <title id="library-sketch-title">Отрисованная стопка секций сайта</title>
            <path class="ink" d="M41 35c71-13 152-13 245 0v45c-91-12-174-11-245 1V35Z" />
            <path class="orange-fill" d="M62 52c54-7 117-6 188 1v13c-69-7-133-7-188 0V52Z" />
            <path class="ink" d="M54 103c78-12 156-12 234 0v38c-79-10-157-10-234 0v-38ZM38 164c86-12 174-12 263 0v34c-88-9-176-9-263 0v-34Z" />
            <path class="ink thin" d="M78 119c29-3 57-3 84 0M181 119c24-2 49-1 75 2M72 178c41-4 82-4 123 0M213 178c26-1 48 0 66 2" />
            <path class="orange-stroke" d="M298 26c15 19 24 44 27 76M20 145c8-9 19-14 33-15" />
          </svg>
        </div>

        <div class="section-table">
          {
            sections.map(([number, title, description]) => (
              <article>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="method" class="mx-auto grid w-full max-w-[1380px] gap-8 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8">
        <div class="method-note">
          <p class="eyebrow">Method</p>
          <h2>Красота появляется, когда есть ограничения.</h2>
          <p>
            Поэтому в макете заранее задаются поля, размерные шкалы, тон текста и правила повторения.
            Эффекты добавляются только там, где они помогают прочитать страницу.
          </p>
          <svg class="method-sketch" viewBox="0 0 420 150" aria-hidden="true">
            <path class="paper-fill" d="M24 35c94-18 208-17 342 2 15 2 25 16 23 31l-5 39c-2 14-15 25-30 23-116-15-222-15-317 1-16 3-31-9-32-26L2 66c-1-15 8-28 22-31Z" />
            <path class="light-ink" d="M24 35c94-18 208-17 342 2 15 2 25 16 23 31l-5 39c-2 14-15 25-30 23-116-15-222-15-317 1-16 3-31-9-32-26L2 66c-1-15 8-28 22-31Z" />
            <path class="method-orange" d="M44 61c49-7 105-8 167-2" />
            <path class="light-ink thin" d="M46 86c84-10 184-9 300 5M48 108c69-8 151-9 246-1M264 55c29 1 57 4 86 8" />
          </svg>
        </div>

        <ol class="principles-list">
          {
            principles.map((principle, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{principle}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="contact" class="mx-auto w-full max-w-[1380px] px-4 pb-8 sm:px-6 lg:px-8">
        <div class="contact-strip">
          <div>
            <p class="eyebrow">Contact</p>
            <h2>Если нужен сайт без ощущения шаблонной сборки — напишите.</h2>
          </div>
          <div class="contact-actions">
            <a href="mailto:ivan.rotov@example.com">Почта</a>
            <a href="https://github.com/">GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex w-full max-w-[1380px] flex-col gap-2 border-t border-black/20 px-4 py-5 text-xs font-bold uppercase tracking-[0.16em] text-black/50 sm:px-6 md:flex-row md:justify-between lg:px-8">
      <p>© 2026 Иван Ротов</p>
      <p>Static site / GitHub Pages</p>
    </footer>
  </body>
</html>
